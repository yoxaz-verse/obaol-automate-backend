PORT=5001
NODE_ENV=development
BASE_URL=http://localhost:5001
MONGODB_URI=mongodb://localhost:27017/obaol
JWT_SECRET=replace-with-a-long-random-secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH_USER=auth@example.com
SMTP_AUTH_PASSWORD=replace-with-smtp-password
SMTP_NOTIFY_USER=notifications@example.com
SMTP_SUPPORT_USER=support@example.com

# Optional startup behavior
RUN_STARTUP_SEEDS=false
SMTP_VERIFY_ON_STARTUP=false
STARTUP_DEBUG_LOGS=false
ENABLE_HTTP_ACCESS_LOGS=false

# Optional licensed GST/GSP lookup integration. Keep all credentials server-side.
# GET appends the GSTIN when the URL does not contain {gstin}. POST sends the
# JSON body template, replacing every {gstin} placeholder at request time.
GST_LOOKUP_URL=https://provider.example.com/gstin/{gstin}
GST_LOOKUP_PROVIDER=provider-name
GST_LOOKUP_METHOD=GET
GST_LOOKUP_API_KEY=replace-with-provider-key
GST_LOOKUP_API_KEY_HEADER=Authorization
GST_LOOKUP_API_KEY_PREFIX=Bearer
GST_LOOKUP_BODY_TEMPLATE={"gstin":"{gstin}"}
GST_LOOKUP_PROOF_SECRET=replace-with-a-separate-long-random-secret
GST_LOOKUP_TIMEOUT_MS=8000
GST_LOOKUP_CACHE_TTL_MS=21600000
GST_LOOKUP_RATE_LIMIT_MAX=10
