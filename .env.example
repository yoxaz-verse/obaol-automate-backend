PORT=5001
NODE_ENV=development
BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://obaol.com (public HTTPS; localhost is rejected)
MONGODB_URI=mongodb://localhost:27017/obaol
JWT_SECRET=replace-with-a-long-random-secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH_USER=auth@example.com
SMTP_AUTH_PASSWORD=replace-with-smtp-password
SMTP_NOTIFY_USER=notifications@example.com
SMTP_SUPPORT_USER=support@example.com

# Company Gmail / Outlook document sending. Register these exact callback URLs
# in the Google Cloud and Microsoft Entra OAuth applications.
MAIL_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
MAIL_OAUTH_STATE_SECRET=replace-with-another-long-random-secret
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
GOOGLE_MAIL_REDIRECT_URI=http://localhost:5001/api/v1/web/mail-connections/google/callback
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_REDIRECT_URI=http://localhost:5001/api/v1/web/mail-connections/microsoft/callback

# Meta WhatsApp Business Platform / Embedded Signup
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v22.0
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-webhook-token
WHATSAPP_OAUTH_STATE_SECRET=replace-with-a-separate-long-random-secret
WHATSAPP_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
META_WHATSAPP_DOCUMENT_TEMPLATE=obaol_trade_document_v1
META_WHATSAPP_INVITATION_TEMPLATE=obaol_participation_invitation_v1
META_WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Configure Meta webhook URL as:
# https://api.example.com/api/v1/web/whatsapp/webhook

# Optional startup behavior
RUN_STARTUP_SEEDS=false
SMTP_VERIFY_ON_STARTUP=false
STARTUP_DEBUG_LOGS=false
ENABLE_HTTP_ACCESS_LOGS=false

# Optional licensed GST/GSP lookup integration. Keep all credentials server-side.
# GET appends the GSTIN when the URL does not contain {gstin}. POST sends the
# JSON body template, replacing every {gstin} placeholder at request time.
GST_LOOKUP_URL=https://provider.example.com/gstin/{gstin}
GST_LOOKUP_PROVIDER=provider-name
GST_LOOKUP_METHOD=GET
GST_LOOKUP_API_KEY=replace-with-provider-key
GST_LOOKUP_API_KEY_HEADER=Authorization
GST_LOOKUP_API_KEY_PREFIX=Bearer
GST_LOOKUP_BODY_TEMPLATE={"gstin":"{gstin}"}
GST_LOOKUP_PROOF_SECRET=replace-with-a-separate-long-random-secret
GST_LOOKUP_TIMEOUT_MS=8000
GST_LOOKUP_CACHE_TTL_MS=21600000
GST_LOOKUP_RATE_LIMIT_MAX=10
